  <script>
    function init3DCarousel(wrapper) {
      const slides = wrapper.querySelectorAll('.carousel-3d-slide');
      const total = slides.length;
      let currentIndex = 0;
      slides[0].classList.add('active');

      function goTo(newIndex, direction) {
        newIndex = (newIndex + total) % total;
        if (newIndex === currentIndex) return;
        const oldSlide = slides[currentIndex];
        const newSlide = slides[newIndex];

        newSlide.style.transition = 'none';
        newSlide.style.transform = `translateX(${direction * 100}%)`;
        newSlide.style.opacity = '0';
        void newSlide.offsetWidth;
        newSlide.style.transition = '';

        requestAnimationFrame(() => {
          oldSlide.classList.remove('active');
          oldSlide.style.transform = `translateX(${-direction * 100}%)`;
          oldSlide.style.opacity = '0';

          newSlide.classList.add('active');
          newSlide.style.transform = 'translateX(0)';
          newSlide.style.opacity = '1';
        });

        currentIndex = newIndex;
      }

      wrapper.querySelector('.carousel-3d-btn.prev').addEventListener('click', () => goTo(currentIndex - 1, -1));
      wrapper.querySelector('.carousel-3d-btn.next').addEventListener('click', () => goTo(currentIndex + 1, 1));

      setInterval(() => goTo(currentIndex + 1, 1), 4000);
    }

    document.querySelectorAll('.carousel-3d-wrapper').forEach(wrapper => init3DCarousel(wrapper));

    function initVideoCarousel(section) {
      const slides = Array.from(section.querySelectorAll('.video-carousel-slide'));
      const total = slides.length;
      const titleEl = section.querySelector('.video-carousel-title');
      const descEl = section.querySelector('.video-carousel-desc');
      const dotsEl = section.querySelector('.video-carousel-dots');
      let currentIndex = 0;

      // Render every title/description stacked in the same spot so the
      // area is always as tall as the longest one and nothing shifts.
      const titles = slides.map(slide => {
        const h2 = document.createElement('h2');
        h2.textContent = slide.dataset.title;
        titleEl.appendChild(h2);
        return h2;
      });
      const descs = slides.map(slide => {
        const p = document.createElement('p');
        p.textContent = slide.dataset.desc;
        descEl.appendChild(p);
        return p;
      });

      const dots = slides.map((_, i) => {
        const dot = document.createElement('button');
        dot.className = 'video-carousel-dot';
        dot.setAttribute('aria-label', `Show video ${i + 1}`);
        dot.addEventListener('click', () => goTo(i));
        dotsEl.appendChild(dot);
        return dot;
      });

      function pause(slide) {
        const iframe = slide.querySelector('iframe');
        if (iframe) {
          iframe.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
        }
        const video = slide.querySelector('video');
        if (video) video.pause();
      }

      function render() {
        slides.forEach((slide, i) => {
          const offset = (i - currentIndex + total) % total;
          slide.classList.remove('is-active', 'is-prev', 'is-next');
          if (offset === 0) slide.classList.add('is-active');
          else if (offset === 1) slide.classList.add('is-next');
          else if (offset === total - 1) slide.classList.add('is-prev');
          if (offset !== 0) pause(slide);
        });
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === currentIndex));
        titles.forEach((el, i) => el.classList.toggle('is-active', i === currentIndex));
        descs.forEach((el, i) => el.classList.toggle('is-active', i === currentIndex));
      }

      function goTo(newIndex) {
        currentIndex = (newIndex + total) % total;
        render();
      }

      section.querySelector('.video-carousel-btn.prev').addEventListener('click', () => goTo(currentIndex - 1));
      section.querySelector('.video-carousel-btn.next').addEventListener('click', () => goTo(currentIndex + 1));
      // Clicking a side video brings it to the center
      slides.forEach((slide, i) => slide.addEventListener('click', () => {
        if (i !== currentIndex) goTo(i);
      }));

      render();
    }

    document.querySelectorAll('.announcements-section').forEach(section => initVideoCarousel(section));
  </script>

